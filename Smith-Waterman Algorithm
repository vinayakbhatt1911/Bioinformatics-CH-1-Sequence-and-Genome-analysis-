MATCH = 2
MISMATCH = -1
GAP = -2


def validate_seq(seq):

    valid = {"A", "T", "G", "C"}

    for nucleotide in seq:

        if nucleotide not in valid:
            return False

    return True


def get_input():

    seq1 = input("Enter Sequence 1 : ").upper()
    seq2 = input("Enter Sequence 2 : ").upper()

    if not validate_seq(seq1):
        print("Invalid Sequence 1")
        return None, None

    if not validate_seq(seq2):
        print("Invalid Sequence 2")
        return None, None

    return seq1, seq2


def matrix_initialize(seq1, seq2):

    matrix = []

    for i in range(len(seq1) + 1):

        row = []

        for j in range(len(seq2) + 1):
            row.append(0)

        matrix.append(row)

    return matrix


def fill_matrix(matrix, seq1, seq2):

    for i in range(1, len(seq1) + 1):

        for j in range(1, len(seq2) + 1):

            if seq1[i - 1] == seq2[j - 1]:
                diagonal = matrix[i - 1][j - 1] + MATCH
            else:
                diagonal = matrix[i - 1][j - 1] + MISMATCH

            up = matrix[i - 1][j] + GAP
            left = matrix[i][j - 1] + GAP

            matrix[i][j] = max(0, diagonal, up, left)

    return matrix


def trace_back(matrix, seq1, seq2):

    max_score = 0
    max_i = 0
    max_j = 0

    # Find highest scoring cell
    for i in range(1, len(seq1) + 1):

        for j in range(1, len(seq2) + 1):

            if matrix[i][j] > max_score:

                max_score = matrix[i][j]
                max_i = i
                max_j = j

    alignment_1 = []
    alignment_2 = []

    i = max_i
    j = max_j

    while matrix[i][j] > 0:

        # Match
        if (seq1[i - 1] == seq2[j - 1] and
                matrix[i][j] == matrix[i - 1][j - 1] + MATCH):

            alignment_1.append(seq1[i - 1])
            alignment_2.append(seq2[j - 1])

            i -= 1
            j -= 1

        # Mismatch
        elif (seq1[i - 1] != seq2[j - 1] and
              matrix[i][j] == matrix[i - 1][j - 1] + MISMATCH):

            alignment_1.append(seq1[i - 1])
            alignment_2.append(seq2[j - 1])

            i -= 1
            j -= 1

        # Gap in Sequence 2
        elif matrix[i][j] == matrix[i - 1][j] + GAP:

            alignment_1.append(seq1[i - 1])
            alignment_2.append("-")

            i -= 1

        # Gap in Sequence 1
        elif matrix[i][j] == matrix[i][j - 1] + GAP:

            alignment_1.append("-")
            alignment_2.append(seq2[j - 1])

            j -= 1

    alignment_1.reverse()
    alignment_2.reverse()

    return "".join(alignment_1), "".join(alignment_2)


def print_matrix(matrix, seq1, seq2):

    print("\nSmith-Waterman Scoring Matrix\n")

    print("      -", end="")

    for char in seq2:
        print(f"{char:>4}", end="")

    print()

    for i in range(len(matrix)):

        if i == 0:
            print(" -", end="")
        else:
            print(f"{seq1[i-1]:>2}", end="")

        for value in matrix[i]:
            print(f"{value:>4}", end="")

        print()


def print_alignment(alignment_1, alignment_2):

    print("\nBest Local Alignment\n")

    print("Sequence 1 :", alignment_1)
    print("Sequence 2 :", alignment_2)


def main():

    seq1, seq2 = get_input()

    if seq1 is None:
        return

    matrix = matrix_initialize(seq1, seq2)

    matrix = fill_matrix(matrix, seq1, seq2)

    alignment_1, alignment_2 = trace_back(matrix, seq1, seq2)

    print_matrix(matrix, seq1, seq2)

    print_alignment(alignment_1, alignment_2)


if __name__ == "__main__":
    main()
